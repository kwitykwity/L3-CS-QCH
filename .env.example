# QCH Connect — example environment configuration
#
# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit it.
#
# Every PROVIDED_BY_QCH_IT value must be supplied by QCH IT.
# Do not guess, and do not substitute values from another project.

# ---------------------------------------------------------------------------
# Server — the only section this scaffold actually reads
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# PLACEHOLDERS — NOT READ BY ANY CODE YET
#
# Listed so QCH IT knows what to provision and so later cards have a home.
# No scaffold code loads, validates, or transmits these.
# ---------------------------------------------------------------------------

# Microsoft Entra ID (sign-in — later card)
AZURE_TENANT_ID=PROVIDED_BY_QCH_IT
AZURE_CLIENT_ID=PROVIDED_BY_QCH_IT
# Earlier-plan placeholder. Under the confirmed production design the Azure
# Functions use a managed identity and no production secret belongs in source
# or browser code (Frozen Handoff PRD §29); QCH IT decides whether sign-in
# still needs a secret. Never put a real value in a committed file.
AZURE_CLIENT_SECRET=PROVIDED_BY_QCH_IT
AZURE_REDIRECT_URI=PROVIDED_BY_QCH_IT

# Earlier-plan placeholder (secret storage). Key Vault is not named in the
# confirmed production architecture; QCH IT decides whether it is needed.
KEY_VAULT_URI=PROVIDED_BY_QCH_IT

# Earlier-plan placeholder, superseded. There is no separate production
# database: production data is planned for SharePoint Lists (Frozen Handoff
# PRD §27). No code reads this. Kept so the contract with QCH IT stays visible.
DATABASE_URL=PROVIDED_BY_QCH_IT

# Shared mailbox / notifications (later card)
NOTIFICATION_MAILBOX=PROVIDED_BY_QCH_IT

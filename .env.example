# QCH Connect environment configuration (example).
#
# Setup: copy this file to .env and edit .env. Never commit .env or real values.
#   cp .env.example .env
#
# Synthetic/local values only in this file. Production values are provided by
# QCH IT and are set in the QCH-owned hosting environment, not in this repo.

# Required. One of: development, demo, test, production.
# Missing or unrecognized values stop the app at startup.
APP_ENV=development

# Optional. Defaults to 3000.
PORT=3000

# ---------------------------------------------------------------------------
# Production only (APP_ENV=production). Left commented on purpose.
# Values come from QCH IT. Variable names are PROVISIONAL and will be
# reconciled with QCH IT provisioning. Do not invent values.
# Secrets (client secrets, connection strings) are NOT set here; they are
# stored in Azure Key Vault.
# ---------------------------------------------------------------------------
# ENTRA_TENANT_ID=<provided-by-qch-it>
# ENTRA_CLIENT_ID=<provided-by-qch-it>
# KEY_VAULT_URI=<provided-by-qch-it>
# AZURE_SQL_SERVER=<provided-by-qch-it>
# AZURE_SQL_DATABASE=<provided-by-qch-it>
# GRAPH_SHARED_MAILBOX=<provided-by-qch-it>
